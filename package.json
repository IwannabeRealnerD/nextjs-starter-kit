{
  "name": "nextjs-starter-kit",
  "version": "0.0.0",
  "description": "NextJS Starter Kit with create command",
  "author": "IwannabeRealnerD <iwannaberealnerd@gmail.com>",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "monorepo",
    "typescript",
    "eslint"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/IwannabeRealnerD/nextjs-starter-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "create-app": "pnpm --filter create-nextjs-starter-kit",
    "project-app": "pnpm --filter nextjs-starter-kit",
    "test:all": "turbo run test",
    "lint:all": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js-pure",
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": "22",
    "pnpm": "10"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af"
}
