{
  "compilerOptions": {
    "esModuleInterop": true,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "@/utils/*": ["./utils/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "es2019"
  },

  "exclude": ["project", "bin"]
}
